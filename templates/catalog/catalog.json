{% import "catalog/macros.json" as m %}
{% import "macros/media.html" as media %}
{% set releases = load_data(path="data/releases.json") %}
{
  "software": [
{%- set_global count = 0 %}
{% set software_section = get_section(path="portfolio/software/_index.md") %}
{%- for page in software_section.pages %}
{%- if page.extra.hub is defined and page.extra.hub.exposed %}
{%- if count > 0 %},{% endif %}
{%- set_global count = count + 1 %}
{%- set logo = page.extra.logo | default(value="") %}
{%- if logo is starting_with("/") %}{% set logo = get_url(path=logo | trim_start_matches(pat="/")) %}{% endif %}
{%- set entries = [] %}
{%- if releases[page.slug] is defined %}{% set entries = releases[page.slug].releases | default(value=[]) %}{% endif %}
    {
      "name": {{ page.extra.project_title | default(value=page.title) | json_encode() | safe }},
      "description": {{ page.description | default(value="") | json_encode() | safe }},
      "url": {{ page.permalink | json_encode() | safe }},
      "icon": {
        "url": {{ media::webp(url=logo) | json_encode() | safe }},
        "width": {{ page.extra.logo_width | default(value=512) }},
        "height": {{ page.extra.logo_height | default(value=512) }}
      },
      "screenshots": [{% for shot in page.extra.screenshot_urls | default(value=[]) %}{{ media::webp(url=shot) | json_encode() | safe }}{% if not loop.last %}, {% endif %}{% endfor %}],
      "platforms": { {% for os, archs in page.extra.hub.targets | default(value=[]) %}
        {{ os | json_encode() | safe }}: [{% for t in archs %}{{ t | json_encode() | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]{% if not loop.last %},{% endif %}{% endfor %}
      },
      "release_count": {{ entries | length }},
      "releases_url": {{ get_url(path="v1/software/" ~ page.slug ~ "/releases.json", trailing_slash=true) | json_encode() | safe }},
      "releases": [{% if entries | length > 0 %}
        {{ m::release(r=entries | first) }}
      {% endif %}]
    }
{%- endif %}
{%- endfor %}
  ]
}
